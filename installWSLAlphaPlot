echo "Installazione AlphaPlot"
sudo apt update
yes Y | sudo apt install flatpak
yes Y | sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
yes Y | flatpak install flathub io.github.narunlifescience.AlphaPlot
echo "Il programma andra runnato con il comando:"
echo "  flatpak run io.github.narunlifescience.AlphaPlot"

